.agents/
.claude/
.codex/
.pi/
skills-lock.json
.playwright-mcp/

.trellis/*
!.trellis/spec/
!.trellis/tasks/
!.trellis/workspace/

# Deployment-local files. .env holds a real deployment's settings and
# compose.override.yaml holds machine-specific limits; only the .example /
# base files are tracked.
.env
compose.override.yaml
compose.override.yml

# Go build artifacts & runtime data
*.exe
*.test
*.db
*.db-shm
*.db-wal

# Local Windows client install (exe + config.yaml with device token).
# A deployment copy, not source: rebuild and re-register instead.
/client-windows/bin/

# Go cross-build outputs in module roots (linux targets have no .exe)
/client-windows/agent
/server/server

# Agent config holds a device bearer token — never commit the real one.
# Only config.example.yaml is tracked.
/client-windows/config*.yaml
!/client-windows/config.example.yaml
