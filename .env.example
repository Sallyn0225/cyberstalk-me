# Copy to .env and edit as needed. Every value below is also the built-in
# default, so an absent .env file is fine — this file exists to document the
# knobs, not because compose requires it.
#
#   cp .env.example .env

# Host port the site is published on. The container always listens on 8080;
# change this side if 8080 is already taken on your machine.
HOST_PORT=8080

# Image tag to run. `latest` tracks the newest release; `edge` tracks the
# main branch; a version like `0.1.0` pins an exact release.
IMAGE_TAG=latest

# How long a device may stay silent before the site shows it as offline.
# Accepts a Go duration (90s, 2m30s) or a bare number of seconds (90).
OFFLINE_THRESHOLD=60s

# How often the server scans for devices that just went silent. Sets the
# worst-case delay between a device going quiet and the UI reacting.
SCAN_INTERVAL=5s
