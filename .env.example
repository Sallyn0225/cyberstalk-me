# Copy to .env and edit as needed. Every value below is also the built-in
# default, so an absent .env file is fine — this file exists to document the
# knobs, not because compose requires it.
#
#   cp .env.example .env

# Host port the site is published on. The container always listens on 8080;
# change this side if 8080 is already taken on your machine.
HOST_PORT=8080

# Image tag to run. `latest` tracks the newest release; `edge` tracks the
# main branch; a version like `0.1.0` pins an exact release.
IMAGE_TAG=latest

# How long a device may stay silent before the site shows it as offline.
# Accepts a Go duration (90s, 2m30s) or a bare number of seconds (90).
OFFLINE_THRESHOLD=60s

# How often the server scans for devices that just went silent. Sets the
# worst-case delay between a device going quiet and the UI reacting.
SCAN_INTERVAL=5s

# Timezone the screen-time view is presented in: which hour of the day a
# minute of usage belongs to, and where one day ends and the next begins. An
# IANA name — an unknown one stops the server at startup rather than silently
# falling back. The tz database is compiled into the binary, so this works
# regardless of the container's own timezone.
#
# Known limitation: usage is accumulated in whole UTC hours, so a zone whose
# offset is not a whole number of hours (UTC+5:30 and friends) has local hour
# boundaries that do not line up with the buckets. The hourly chart can be off
# by up to 30 minutes, and so can usage landing on the right side of midnight.
# The default UTC+8 is unaffected.
DISPLAY_TIMEZONE=Asia/Shanghai

# How many days of hourly usage statistics are kept. Older buckets are deleted
# on a timer. Roughly 12 KB per device per day, so the default is about 4.4 MB
# per device. Must be a positive whole number of days.
USAGE_RETENTION_DAYS=365

# How often the retention sweep runs. Also runs once at startup.
USAGE_PRUNE_INTERVAL=1h

# The longest silence still counted as "the device kept doing what it was last
# seen doing". Anything longer is treated as a blind spot and contributes no
# time at all, so a machine that was asleep overnight does not come back as
# eight hours of usage.
#
# Left empty it follows OFFLINE_THRESHOLD, which is the same line drawn for a
# different purpose. Set it explicitly when you want a generous offline
# tolerance without also widening what counts as usage.
USAGE_MAX_GAP=

# Container log retention. The server logs to stdout, so without these the
# Docker json-file log grows until it fills the disk. Total worst case is
# LOG_MAX_SIZE * LOG_MAX_FILE (30 MiB by default); once full, the oldest
# rotation is dropped. LOG_MAX_SIZE takes a k/m/g suffix.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
